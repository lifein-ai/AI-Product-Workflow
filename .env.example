PORT=3000
HOST=127.0.0.1
AI_PROVIDER=relay
MODELFLARE_API_KEY=
MODELFLARE_BASE_URL=https://modelflare.dev/v1
MODELFLARE_MODEL=gpt-5.6-terra
# Optional: defaults to .runtime/projects
# WORKFLOW_DATA_DIR=.runtime/projects
# Optional server-side API/model library file (defaults to .runtime/provider-library.json)
# WORKFLOW_PROVIDER_LIBRARY_PATH=.runtime/provider-library.json
# Optional provider limits
# MODELFLARE_TIMEOUT_MS=240000
# MODELFLARE_REPAIR_TIMEOUT_MS=180000
# MODELFLARE_MAX_RETRIES=1
# MODELFLARE_STREAMING=0
# MODELFLARE_MAX_OUTPUT_TOKENS=8192
# Optional Local Codex Provider settings
# CODEX_COMMAND=codex
# CODEX_MODEL=
# CODEX_TIMEOUT_MS=240000
# CODEX_MAX_RETRIES=0
# Optional request-boundary logs: Initial Request / Tool Loop Continuation
# DISCOVERY_REQUEST_LOG=1
